# Where contact messages are emailed
OWNER_EMAIL=owner@example.com

# SMTP account used to send the email (Gmail example: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Social Technologies <you@example.com>"

# Server port (the built site and /api are served from here)
PORT=8787
